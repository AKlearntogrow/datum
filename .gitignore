# ===== Python =====
   # File-extension patterns are safe to apply globally — they only match Python artifacts.
   __pycache__/
   *.py[cod]
   *$py.class
   *.so
   .Python
   *.egg-info/
   *.egg
   .installed.cfg
   MANIFEST

   # Directory-name patterns are anchored to backend/ to prevent collisions with frontend.
   # (e.g. "lib/" without anchoring would also match frontend/src/lib/.)
   backend/**/build/
   backend/**/develop-eggs/
   backend/**/dist/
   backend/**/downloads/
   backend/**/eggs/
   backend/**/.eggs/
   backend/**/lib/
   backend/**/lib64/
   backend/**/parts/
   backend/**/sdist/
   backend/**/var/
   backend/**/wheels/
