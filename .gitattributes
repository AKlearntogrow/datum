# Auto-detect text files and normalize line endings to LF in the repository.
# Windows users will see CRLF locally; Mac/Linux users will see LF.
# This prevents line-ending churn in diffs when the team is cross-platform.

* text=auto eol=lf

# Explicitly mark these as text regardless of content
*.py       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf

# Windows batch/PowerShell files keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary files — don't touch
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
